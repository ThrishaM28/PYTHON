#STRING TO INTEGER
a=["123","567","890"]
b=list(map(int,a))
print(b)

#UPPERCASE
l=["apple","orange","grapes"]
b=list(map(lambda x:x.upper(),l))
print(b)

#LENGTH 
b=list(map(len,l))
print(b)

#GRACE MARKS 
d=[123,567,890]
b=list(map(lambda y:y+2,d))
print(b)

#ADDING TWO LIST
e=[10,20,30]
f=[40,50,60]
b=list(map(lambda w,z:w+z,e,f))
print(b)

#UPPERCASE USING DICTIONARY
g={'A':'ram','B':'mani','C':'rose'}
b=dict(map(lambda x:(x[0],x[1].upper()),g.items()))
print(b)

#GRACE MARKS IN PERCENTAGE
h={'Ram':50,'Rose':60,'Mani':70,'Pavi':80}
b=dict(map(lambda x:(x[0],(x[1]//10)+x[1]),h.items()))
print(b)
