s=input("Enter your Password: ")
up=0
lw=0
dg=0
spl=0
if len(s)>7:
    for i in s:
        if i.isupper():
            up=up+1
        elif i.islower():
            lw=lw+1
        elif i.isdigit():
            dg=dg+1
        else:
            spl=spl+1
    if (up>0 and lw>0 and dg>0 and spl>0):
        print("STRONG PASSWORD")
    else:
        print("WEAK PASSWORD")
else:
    print("VERY WEAK PASSWORD")
