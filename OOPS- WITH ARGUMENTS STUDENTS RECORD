col="HITS"
class IT:
    dept="Information Technology"
    def get_sum(self,a,b,c,d):
        self.m1=a
        self.m2=b
        self.m3=c
        self.name=d
    def display(self):
        print("1. NAME: ",self.name)
        print("2. MARKS: ",(self.m1+self.m2+self.m3)//3)
        print("3. DEPT: ",IT.dept)
        print("4. COLLEGE: ",col)
        print()
    
